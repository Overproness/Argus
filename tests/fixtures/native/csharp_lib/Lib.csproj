<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The newest runtime the installed SDK ships, so the fixture builds offline. -->
    <TargetFramework>net$([System.Version]::Parse('$(BundledNETCoreAppPackageVersion)').Major).0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
</Project>
